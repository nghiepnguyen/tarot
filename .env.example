# Copy to .env.local and fill in real values. Never commit .env.local.

# Local dev. Trên Vercel (Production) đặt: https://tarot.thanhnghiep.top
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Matches docker-compose.yml's default local Postgres credentials.
DATABASE_URL=postgresql://tarot:tarot@localhost:5432/tarot

# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Get a key at https://aistudio.google.com/apikey — required to unlock AI
# interpretations. Without it, the unlock button shows a clear error instead
# of crashing.
GEMINI_API_KEY=

# PayOS (https://payos.vn) — dùng để nạp credit thật. Lấy trong kênh thanh
# toán của merchant sau khi đăng ký tài khoản PayOS.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Bảo vệ cron đối soát đơn hàng (/api/cron/reconcile-orders). Vercel Cron gửi
# giá trị này trong header Authorization. Không set thì endpoint trả 503 và
# webhook mất lưới an toàn. Generate with: openssl rand -base64 32
CRON_SECRET=

# Resend (https://resend.com) — gửi cảnh báo vận hành về sự cố thanh toán VÀ
# email xác nhận đăng ký. Thiếu thì cảnh báo bị bỏ qua kèm log warning, còn
# đăng ký vẫn tạo được tài khoản nhưng link xác nhận chỉ in ra server log
# (đủ để chạy local, KHÔNG dùng được trên production).
RESEND_API_KEY=
# Địa chỉ gửi đi. Domain phải được verify trong Resend trước.
ALERT_EMAIL_FROM=alert@thanhnghiep.top
# Địa chỉ gửi email xác nhận cho khách. Không set thì dùng ALERT_EMAIL_FROM.
AUTH_EMAIL_FROM=no-reply@thanhnghiep.top

# Sentry (https://sentry.io) — theo dõi lỗi runtime và hiệu năng. Thiếu DSN
# thì SDK vẫn nạp nhưng không gửi gì, app chạy bình thường. DSN là giá trị
# công khai (nằm sẵn trong bundle trình duyệt), lấy ở Settings > Projects >
# Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN=

# Chỉ cần lúc build để upload source map, nếu không stack trace trong Sentry
# vẫn ở dạng minify. Tạo ở Settings > Auth Tokens với scope project:releases.
# Trên Vercel nhớ đặt cho cả Production lẫn Preview.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
