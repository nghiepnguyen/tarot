# Copy to .env.local and fill in real values. Never commit .env.local.

# Local dev. Trên Vercel (Production) đặt: https://tarot.thanhnghiep.top
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Matches docker-compose.yml's default local Postgres credentials.
DATABASE_URL=postgresql://tarot:tarot@localhost:5432/tarot

# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Get a key at https://aistudio.google.com/apikey — required to unlock AI
# interpretations. Without it, the unlock button shows a clear error instead
# of crashing.
GEMINI_API_KEY=

# PayOS (https://payos.vn) — dùng để nạp credit thật. Lấy trong kênh thanh
# toán của merchant sau khi đăng ký tài khoản PayOS.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
