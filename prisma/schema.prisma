generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id                   String             @id @default(cuid())
  email                String             @unique
  passwordHash         String
  name                 String?
  // Null nghĩa là chưa bấm link trong email xác nhận. Tài khoản tồn tại nhưng
  // không đăng nhập được và chưa được tặng credit dùng thử.
  emailVerifiedAt      DateTime?
  // Mốc đổi mật khẩu gần nhất. Session là JWT không tra database, nên đây là
  // thứ duy nhất cho phép hạ những phiên đã phát trước lần đổi đó.
  passwordChangedAt    DateTime?
  // Cấp bằng `pnpm grant-admin <email>`. Không có đường nào trong giao diện
  // nâng quyền cho chính mình hay cho người khác.
  role                 Role               @default(USER)
  credits              Int                @default(0)
  freeCreditsGrantedAt DateTime?
  createdAt            DateTime           @default(now())
  readings             Reading[]
  creditTransactions   CreditTransaction[]
  orders               Order[]
  verificationTokens   EmailVerificationToken[]
  passwordResetTokens  PasswordResetToken[]
}

/// Link xác nhận email gửi lúc đăng ký (và lúc bấm "gửi lại").
///
/// Chỉ lưu SHA-256 của token, không lưu token thật: đọc được database cũng
/// không kích hoạt được tài khoản của người khác. Token thật chỉ nằm trong
/// email đã gửi đi.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Link đặt lại mật khẩu.
///
/// Cùng cách lưu như [EmailVerificationToken]: chỉ có SHA-256 vào database.
/// Khác ở chỗ hạn ngắn hơn nhiều — token này đổi được mật khẩu, còn token xác
/// nhận chỉ mở khoá một tài khoản vốn đã là của người đăng ký.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

enum CreditTransactionType {
  FREE_GRANT
  PURCHASE
  UNLOCK_SPEND
  REFUND
  ADMIN_ADJUST
}

model CreditTransaction {
  id               String                @id @default(cuid())
  userId           String
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             CreditTransactionType
  amount           Int
  balanceAfter     Int
  relatedReadingId String?
  relatedOrderId   String?
  createdAt        DateTime              @default(now())

  @@index([userId, createdAt])
}

model CreditPackage {
  id        String   @id @default(cuid())
  name      String
  credits   Int
  priceVnd  Int
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  orders    Order[]
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELLED
  REFUNDED
}

model Order {
  id                    String        @id @default(cuid())
  userId                String
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId             String
  package               CreditPackage @relation(fields: [packageId], references: [id])
  provider              String
  providerOrderId       String        @unique
  // Link id PayOS trả về lúc tạo payment request. Cần để đối soát lại trạng
  // thái đơn khi webhook không tới.
  providerPaymentLinkId String?
  amountVnd             Int
  creditsGranted        Int
  status                OrderStatus   @default(PENDING)
  createdAt             DateTime      @default(now())
  expiresAt             DateTime?
  paidAt                DateTime?
  reconciledAt          DateTime?

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

/// Nhật ký thao tác quản trị.
///
/// `CreditTransaction` ghi *cái gì* xảy ra với số dư, không ghi *ai* và *vì
/// sao*. Điều đó đủ khi mọi đường ghi đều là máy (`PURCHASE` là webhook,
/// `UNLOCK_SPEND` là người dùng, `FREE_GRANT` là lúc xác nhận email).
/// `ADMIN_ADJUST` và nút hoàn tiền trên web là những đường đầu tiên mang quyết
/// định của một con người, nên phải có chỗ ký tên.
///
/// Cố tình không có quan hệ khoá ngoại tới `User` hay `Order`: xoá tài khoản
/// đang cascade sang đơn và giao dịch, mà dòng nhật ký thì phải sống lâu hơn
/// đối tượng của nó. Lưu id dạng chuỗi thuần, đúng như `relatedOrderId`.
model AdminAuditLog {
  id            String   @id @default(cuid())
  adminUserId   String
  /// "credit_adjust" | "order_refund" | "order_reconcile"
  action        String
  targetUserId  String?
  targetOrderId String?
  amount        Int?
  reason        String
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([adminUserId, createdAt])
}

model Reading {
  id               String            @id @default(cuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  question         String
  cards            Json
  createdAt        DateTime          @default(now())
  aiInterpretation AiInterpretation?

  @@index([userId, createdAt])
}

model AiInterpretation {
  id                    String   @id @default(cuid())
  readingId             String   @unique
  reading               Reading  @relation(fields: [readingId], references: [id], onDelete: Cascade)
  summary               String?
  overview              String
  themes                Json?
  perCard               Json
  connections           String
  // Legacy single-paragraph form, kept for rows written before
  // actionSuggestionsList existed.
  actionSuggestions     String
  actionSuggestionsList Json?
  reflectiveQuestion    String
  closingNote           String?
  model                 String
  /// Id bản prompt đã sinh ra row này, trỏ vào registry ở `lib/ai/prompts/`.
  /// Nullable vì row cũ không có: migration `add_prompt_version` chỉ backfill
  /// những row có token usage — phần còn lại không có bằng chứng nào chỉ ra
  /// prompt nào đã sinh ra chúng. Id không còn trong registry vẫn thống kê được.
  promptVersion         String?
  // Chi phí mỗi lượt sinh. Nullable vì những row viết trước khi có các cột
  // này không có số, và vì Gemini không đảm bảo luôn trả usageMetadata.
  // thinkingTokens tách riêng khỏi outputTokens dù cả hai tính cùng một giá:
  // phần thinking phình nhanh hơn phần chữ mỗi khi prompt siết thêm ràng
  // buộc, và gộp lại thì không còn nhìn ra điều đó.
  inputTokens           Int?
  outputTokens          Int?
  thinkingTokens        Int?
  latencyMs             Int?
  createdAt             DateTime @default(now())
  review                InterpretationReview?

  @@index([promptVersion])
}

/// Người đọc chấm điểm chính bản diễn giải vừa đọc.
///
/// Sinh ra cùng chế độ chọn model ngẫu nhiên: mỗi model ký tên bằng một bút
/// danh (`lib/ai/models.ts`), nên người chấm không biết mình đang chấm nhà
/// cung cấp nào. Đó là điểm của cả cơ chế — ba con số ở đây chỉ có nghĩa khi
/// người chấm không nhìn thấy nhãn.
///
/// Gắn vào `AiInterpretation` chứ không vào `Reading`: thứ được chấm là bản
/// chữ do một cặp (prompt, model) cụ thể sinh ra, và `/admin/prompts` cộng
/// điểm theo đúng cặp đó.
///
/// `@unique` trên `interpretationId`: một bản diễn giải một đánh giá. Nhưng
/// sửa được — người ta bấm vội rồi đọc kỹ lại — nên đường ghi là upsert và
/// `updatedAt` là thứ phân biệt bản đầu với bản sửa.
///
/// `userId` để trần, không khoá ngoại: row này đã cascade theo
/// `AiInterpretation` → `Reading` → `User` rồi, thêm một quan hệ nữa chỉ để
/// lặp lại cùng một vòng đời.
model InterpretationReview {
  id               String           @id @default(cuid())
  interpretationId String           @unique
  interpretation   AiInterpretation @relation(fields: [interpretationId], references: [id], onDelete: Cascade)
  userId           String
  /// Ba tiêu chí, mỗi tiêu chí 1–5 sao. Khoảng giá trị do `lib/ai/reviews.ts`
  /// canh trước khi ghi: Postgres không có kiểu "1 đến 5".
  accuracy         Int
  clarity          Int
  actionability    Int
  /// Nhận xét tự do, không bắt buộc.
  comment          String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([createdAt])
}

/// Cấu hình chỉnh được lúc đang chạy, dạng khóa–giá trị.
///
/// Chỉ dành cho những lựa chọn phải đổi được *không cần deploy*. Prompt và bộ
/// bài không nằm ở đây có chủ đích (xem `lib/ai/prompts/types.ts`): chúng cột
/// chặt vào JSON schema và ràng buộc an toàn. Model thì khác — đổi model không
/// đổi hợp đồng đầu ra, mà lại là thứ cần lùi lại trong vài phút khi một nhà
/// cung cấp hỏng.
///
/// Giá trị lưu dạng chuỗi và luôn phải qua một danh sách cho phép trong code
/// trước khi dùng (`lib/ai/models.ts`): một hàng rác trong bảng này không được
/// phép biến thành một lời gọi API tới model không ai kiểm giá.
model AppSetting {
  key       String   @id
  value     String
  /// Ai đổi lần gần nhất. Chi tiết *vì sao* nằm ở `AdminAuditLog`.
  updatedBy String?
  updatedAt DateTime @updatedAt
}
