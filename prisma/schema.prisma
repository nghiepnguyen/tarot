generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String             @id @default(cuid())
  email                String             @unique
  passwordHash         String
  name                 String?
  // Null nghĩa là chưa bấm link trong email xác nhận. Tài khoản tồn tại nhưng
  // không đăng nhập được và chưa được tặng credit dùng thử.
  emailVerifiedAt      DateTime?
  // Mốc đổi mật khẩu gần nhất. Session là JWT không tra database, nên đây là
  // thứ duy nhất cho phép hạ những phiên đã phát trước lần đổi đó.
  passwordChangedAt    DateTime?
  credits              Int                @default(0)
  freeCreditsGrantedAt DateTime?
  createdAt            DateTime           @default(now())
  readings             Reading[]
  creditTransactions   CreditTransaction[]
  orders               Order[]
  verificationTokens   EmailVerificationToken[]
  passwordResetTokens  PasswordResetToken[]
}

/// Link xác nhận email gửi lúc đăng ký (và lúc bấm "gửi lại").
///
/// Chỉ lưu SHA-256 của token, không lưu token thật: đọc được database cũng
/// không kích hoạt được tài khoản của người khác. Token thật chỉ nằm trong
/// email đã gửi đi.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Link đặt lại mật khẩu.
///
/// Cùng cách lưu như [EmailVerificationToken]: chỉ có SHA-256 vào database.
/// Khác ở chỗ hạn ngắn hơn nhiều — token này đổi được mật khẩu, còn token xác
/// nhận chỉ mở khoá một tài khoản vốn đã là của người đăng ký.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

enum CreditTransactionType {
  FREE_GRANT
  PURCHASE
  UNLOCK_SPEND
  REFUND
  ADMIN_ADJUST
}

model CreditTransaction {
  id               String                @id @default(cuid())
  userId           String
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             CreditTransactionType
  amount           Int
  balanceAfter     Int
  relatedReadingId String?
  relatedOrderId   String?
  createdAt        DateTime              @default(now())

  @@index([userId, createdAt])
}

model CreditPackage {
  id        String   @id @default(cuid())
  name      String
  credits   Int
  priceVnd  Int
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  orders    Order[]
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELLED
  REFUNDED
}

model Order {
  id                    String        @id @default(cuid())
  userId                String
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId             String
  package               CreditPackage @relation(fields: [packageId], references: [id])
  provider              String
  providerOrderId       String        @unique
  // Link id PayOS trả về lúc tạo payment request. Cần để đối soát lại trạng
  // thái đơn khi webhook không tới.
  providerPaymentLinkId String?
  amountVnd             Int
  creditsGranted        Int
  status                OrderStatus   @default(PENDING)
  createdAt             DateTime      @default(now())
  expiresAt             DateTime?
  paidAt                DateTime?
  reconciledAt          DateTime?

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model Reading {
  id               String            @id @default(cuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  question         String
  cards            Json
  createdAt        DateTime          @default(now())
  aiInterpretation AiInterpretation?

  @@index([userId, createdAt])
}

model AiInterpretation {
  id                    String   @id @default(cuid())
  readingId             String   @unique
  reading               Reading  @relation(fields: [readingId], references: [id], onDelete: Cascade)
  summary               String?
  overview              String
  themes                Json?
  perCard               Json
  connections           String
  // Legacy single-paragraph form, kept for rows written before
  // actionSuggestionsList existed.
  actionSuggestions     String
  actionSuggestionsList Json?
  reflectiveQuestion    String
  closingNote           String?
  model                 String
  // Chi phí mỗi lượt sinh. Nullable vì những row viết trước khi có các cột
  // này không có số, và vì Gemini không đảm bảo luôn trả usageMetadata.
  // thinkingTokens tách riêng khỏi outputTokens dù cả hai tính cùng một giá:
  // phần thinking phình nhanh hơn phần chữ mỗi khi prompt siết thêm ràng
  // buộc, và gộp lại thì không còn nhìn ra điều đó.
  inputTokens           Int?
  outputTokens          Int?
  thinkingTokens        Int?
  latencyMs             Int?
  createdAt             DateTime @default(now())
}
