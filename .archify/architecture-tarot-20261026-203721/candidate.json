  "cards": [
    {
      "dot": "cyan",
      "title": "Reading loop",
      "items": [
        "The 78-card shuffle and orientation happen in the browser; only three picked cards are sent.",
        "saveReadingAction validates the spread, rate-limits to 30 per hour, and stores a Reading row.",
        "An existing AiInterpretation is returned before any credit is charged.",
        "10 credits are decremented first; a generation failure refunds them and reports to Sentry."
      ]
    },
    {
      "dot": "emerald",
      "title": "Credits & payments",
      "items": [
        "PayOS links expire after 30 minutes; every Order starts PENDING.",
        "The webhook verifies an HMAC signature, then re-checks order status and amount before crediting.",
        "Return-page polling and the 20:00 UTC cron reconcile orders when the webhook is late.",
        "Email verification grants 20 credits (two unlocks); every balance change writes a ledger row."
      ]
    },
    {
      "dot": "violet",
      "title": "Model routing",
      "items": [
        "Prompt versions v1–v7 are frozen in code; v7 is the active version.",
        "An admin setting picks Gemini, DeepSeek, or a random model per unlock from an allow-list.",
        "Gemini enforces a response schema; DeepSeek only guarantees JSON mode.",
        "AiGenerationMetric records latency, tokens, outcome, and quality warnings for every attempt."
      ]
    },
    {
      "dot": "amber",
      "title": "Security & operations",
      "items": [
        "Auth.js uses JWT sessions; signup stays locked until the email link is opened.",
        "Role and password changes are re-read from Postgres every five minutes.",
        "Rate limits for signup, saves, unlocks, checkout, and alerts live in Postgres.",
        "Admin actions re-check the database role and write AdminAuditLog; Sentry tunnels through /monitoring."
      ]
    }
  ]
